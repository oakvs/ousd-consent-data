                "required": [
                  "summary"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "auto_ok",
                  "needs_review",
                  "blocked",
                  "human_reviewed",
                  "pending"
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "outcome": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "adopted": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "action",
                  "date",
                  "adopted"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "enrichment": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "headline": {
                    "type": "string",
                    "maxLength": 140
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 900
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "Special education",
                      "Classroom & academic programs",
                      "After-school & summer programs",
                      "Student health, support & family services",
                      "School buildings & construction",
                      "Food, transportation & operations",
                      "Technology",
                      "Staff & hiring",
                      "Legal, insurance & risk",
                      "School plans",
                      "Partnerships & data sharing",
                      "Governance & board business"
                    ]
                  },
                  "actionType": {
                    "type": "string",
                    "enum": [
                      "new_agreement",
                      "amendment",
                      "change_order",
                      "bid_award",
                      "cooperative_purchase",
                      "mou_or_data_sharing",
                      "grant_or_funding_in",
                      "school_plan",
                      "personnel",
                      "resolution_or_policy",
                      "termination",
                      "other"
                    ]
                  },
                  "vendor": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "location": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "kind": {
                        "default": null,
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "individual",
                              "organization"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "location",
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  "schools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "money": {
                    "type": "object",
                    "properties": {
                      "direction": {
                        "type": "string",
                        "enum": [
                          "expense",
                          "revenue",
                          "decrease",
                          "no_cost"
                        ]
                      },
                      "amountType": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "not_to_exceed",
                              "fixed",
                              "cumulative",
                              "per_year",
                              "sales_cap"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "thisAction": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "thisActionRange": {
                        "anyOf": [
                          {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "number"
                              }
                            ],
                            "items": false,
                            "minItems": 2,
                            "maxItems": 2
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "priorTotal": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "newTotal": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "direction",
                      "amountType",
                      "thisAction",
                      "thisActionRange",
                      "priorTotal",
                      "newTotal"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "headline",
                  "summary",
                  "category",
                  "actionType",
                  "vendor",
                  "schools",
                  "money"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "vendorKey",
          "agendaNumber",
          "agendaSequence",
          "consentSection",
          "group",
          "file",
          "title",
          "matterType",
          "presenter",
          "vendorNo",
          "fundingSource",
          "flags",
          "sourceIssue",
          "amountVerified",
          "pulled",
          "review",
          "outcome",
          "enrichment"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "meeting",
    "totals",
    "items"
  ],
  "additionalProperties": false
}
