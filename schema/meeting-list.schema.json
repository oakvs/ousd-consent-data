{
  "$id": "https://raw.githubusercontent.com/oakvs/ousd-consent-data/main/schema/meeting-list.schema.json",
  "title": "Meeting list",
  "description": "data/published/meetings/{key}.list.json (schema version 1.0.0). Generated from packages/consent-schema; do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "meeting": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(-[a-z]+)?$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "time": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "regular",
            "special",
            "organizational"
          ]
        },
        "title": {
          "type": "string"
        },
        "eventId": {
          "type": [
            "number",
            "null"
          ]
        },
        "agendaPdfUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "legistarMeetingUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "consentVotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "motion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mover": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "seconder": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "passed": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "votes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "vote": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "vote"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "title",
              "action",
              "motion",
              "mover",
              "seconder",
              "passed",
              "votes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "date",
        "time",
        "kind",
        "title",
        "eventId",
        "agendaPdfUrl",
        "legistarMeetingUrl",
        "revision",
        "updatedAt",
        "note",
        "consentVotes"
      ],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "items": {
          "type": "number"
        },
        "enrichedItems": {
          "type": "number"
        },
        "spendingTotal": {
          "type": "number"
        },
        "spendingItems": {
          "type": "number"
        },
        "yearlyCapsTotal": {
          "type": "number"
        },
        "yearlyCapItems": {
          "type": "number"
        },
        "revenueTotal": {
          "type": "number"
        },
        "revenueItems": {
          "type": "number"
        },
        "decreaseTotal": {
          "type": "number"
        },
        "paymentsRatifiedTotal": {
          "type": "number"
        },
        "paymentsRatifiedItems": {
          "type": "number"
        },
        "flagCounts": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "byCategory": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "items": {
                "type": "number"
              },
              "spending": {
                "type": "number"
              }
            },
            "required": [
              "items",
              "spending"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items",
        "enrichedItems",
        "spendingTotal",
        "spendingItems",
        "yearlyCapsTotal",
        "yearlyCapItems",
        "revenueTotal",
        "revenueItems",
        "decreaseTotal",
        "paymentsRatifiedTotal",
        "paymentsRatifiedItems",
        "flagCounts",
        "byCategory"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "vendorKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "agendaNumber": {
            "type": "string"
          },
          "agendaSequence": {
            "type": "number"
          },
          "consentSection": {
            "type": "string",
            "enum": [
              "general",
              "bonds"
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "matterType": {
            "type": [
              "string",
              "null"
            ]
          },
          "presenter": {
            "type": [
              "string",
              "null"
            ]
          },
          "vendorNo": {
            "type": [
              "string",
              "null"
            ]
          },
          "fundingSource": {
            "type": [
              "string",
              "null"
            ]
          },
          "flags": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "no_competitive_bid",
                    "multi_year",
                    "time_extension_only",
                    "emergency"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "after_work_began",
                    "raises_existing_contract",
                    "previously_delayed",
                    "source_issue",
                    "large_increase",
                    "yearly_cap",
                    "no_total_stated",
                    "pulled_from_consent",
                    "payment_ratification"
                  ]
                }
              ]
            }
          },
          "sourceIssue": {
            "type": [
              "string",
              "null"
            ]
          },
          "amountVerified": {
            "type": "boolean"
          },
          "pulled": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "summary": {
                    "type": "string"
                  }
