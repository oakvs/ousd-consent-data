{
  "$id": "https://raw.githubusercontent.com/oakvs/ousd-consent-data/main/schema/registry.schema.json",
  "title": "Meeting registry",
  "description": "data/meetings.json (schema version 2.0.0). Generated from packages/consent-schema; do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lastKnownEventId": {
      "type": [
        "number",
        "null"
      ]
    },
    "meetings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(-[a-z]+)?$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "regular",
              "special",
              "organizational"
            ]
          },
          "eventId": {
            "type": [
              "number",
              "null"
            ]
          },
          "resolvedBy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "history",
                  "probe",
                  "manual",
                  "prototype"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "meetingDetailId": {
            "type": [
              "number",
              "null"
            ]
          },
          "agendaPdfUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "discovered",
              "ingested",
              "published",
              "final",
              "skipped"
            ]
          },
          "lastIngestedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventItemsHash": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "historiesCheckedOn": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "date",
          "time",
          "kind",
          "eventId",
          "resolvedBy",
          "meetingDetailId",
          "agendaPdfUrl",
          "status",
          "lastIngestedAt",
          "note"
        ]
      }
    }
  },
  "required": [
    "lastKnownEventId",
    "meetings"
  ]
}
