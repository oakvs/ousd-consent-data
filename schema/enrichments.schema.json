{
  "$id": "https://raw.githubusercontent.com/oakvs/ousd-consent-data/main/schema/enrichments.schema.json",
  "title": "AI enrichments",
  "description": "data/enrichments/{key}.json (schema version 2.0.0). Generated from packages/consent-schema; do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meetingKey": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(-[a-z]+)?$"
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string"
          },
          "promptVersion": {
            "type": "string"
          },
          "cacheKey": {
            "type": "string"
          },
          "output": {
            "type": "object",
            "properties": {
              "headline": {
                "type": "string",
                "maxLength": 140
              },
              "summary": {
                "type": "string",
                "maxLength": 900
              },
              "category": {
                "type": "string",
                "enum": [
                  "Special education",
                  "Classroom & academic programs",
                  "After-school & summer programs",
                  "Student health, support & family services",
                  "School buildings & construction",
                  "Food, transportation & operations",
                  "Technology",
                  "Staff & hiring",
                  "Legal, compliance & risk",
                  "School plans",
                  "Partnerships & data sharing",
                  "Budget, finance & payments",
                  "Governance & board business"
                ]
              },
              "subcategory": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "Nonpublic schools & agencies",
                      "Transportation",
                      "Services & contract staff",
                      "Programs & support",
                      "Legal, compliance & policy"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actionType": {
                "type": "string",
                "enum": [
                  "new_agreement",
                  "amendment",
                  "change_order",
                  "bid_award",
                  "cooperative_purchase",
                  "mou_or_data_sharing",
                  "grant_or_funding_in",
                  "school_plan",
                  "personnel",
                  "resolution_or_policy",
                  "termination",
                  "other"
                ]
              },
              "vendor": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "location": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "kind": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "individual",
                          "organization"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "location"
                ]
              },
              "schools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "money": {
                "type": "object",
                "properties": {
                  "direction": {
                    "type": "string",
                    "enum": [
                      "expense",
                      "revenue",
                      "decrease",
                      "no_cost"
                    ]
                  },
                  "amountType": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "not_to_exceed",
                          "fixed",
                          "cumulative",
                          "per_year",
                          "sales_cap"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "thisAction": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "thisActionRange": {
                    "anyOf": [
                      {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "priorTotal": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "newTotal": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "byYear": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "number"
                    }
                  },
                  "evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "direction",
                  "amountType",
                  "thisAction",
                  "thisActionRange",
                  "priorTotal",
                  "newTotal",
                  "byYear",
                  "evidence"
                ]
              },
              "term": {
                "type": "object",
                "properties": {
                  "start": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "addedStart": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "start",
                  "end"
                ]
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "no_competitive_bid",
                    "multi_year",
                    "time_extension_only",
                    "emergency"
                  ]
                }
              },
              "sourceIssueCandidate": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "uncertain": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "headline",
              "summary",
              "category",
              "subcategory",
              "actionType",
              "vendor",
              "schools",
              "money",
              "term",
              "flags",
              "sourceIssueCandidate",
              "uncertain"
            ]
          }
        },
        "required": [
          "modelId",
          "promptVersion",
          "cacheKey",
          "output"
        ]
      }
    }
  },
  "required": [
    "meetingKey",
    "items"
  ]
}
